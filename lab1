import math
def fib(n):
    m = [1,2]
    while n>=m[-1]+m[-2]:
        m.append(m[-1]+m[-2])
    a = ''
    while n!=0:
        for i in m[::-1]:
            if i<=n:
                a+='1'
                n-=i
            else:
                a+='0'
    return a
print(fib(350))
def fact(n):
    a = str(n)
    k = len(a)
    res = 0
    for i in a:
        res+=int(i)*math.factorial(k)
        k-=1
    return res
print(fact(441321))
def m_ten(n):
    a = str(n)
    k = len(a)-1
    res = 0
    for i in a:
        res+=int(i)*(-10)**k
        k-=1
    return res
print(m_ten(615))
def nine_s(n):
    m = []
    a=0
    while n!=0:
        a = n%9
        if a>4:
            a-=9
            n=n//9+1
        else:
            n//=9
        m.append(str(a))
    return ''.join(m[::-1])
print(nine_s(-16412))
